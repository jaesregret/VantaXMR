<Window x:Class="Vanta.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vanta — XMR Miner"
        Width="1080"
        Height="730"
        MinWidth="920"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VANTA" FontSize="31" FontWeight="Bold" />
                <TextBlock Text="XMR · RandomX desktop miner" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="1,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#193A2C" CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9CA9BC" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="PRONTO" FontSize="12" FontWeight="Bold" Foreground="#BFF7D9" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Configuração" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Sua carteira e a conexão com o pool ficam somente neste computador." Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,5,0,23" TextWrapping="Wrap" />

                        <TextBlock Text="CARTEIRA MONERO" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WalletTextBox" MinHeight="40" ToolTip="Endereço público da carteira; nunca informe seed phrase ou chave privada." />
                        <TextBlock Text="Use apenas o endereço público. A seed phrase e a chave privada nunca são necessárias." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,6,0,20" TextWrapping="Wrap" />

                        <TextBlock Text="HOST DO POOL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PoolHostTextBox" MinHeight="40" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PORTA" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PortComboBox" IsEditable="True" MinHeight="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="THREADS" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ThreadsComboBox" MinHeight="40" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="TlsCheckBox" Content="Usar conexão TLS" Foreground="{StaticResource TextBrush}" Margin="0,22,0,0" />
                        <TextBlock Text="Use TLS apenas quando a porta do pool oferecer suporte." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="24,4,0,24" />

                        <Button x:Name="StartStopButton" Content="Iniciar mineração" Style="{StaticResource PrimaryButton}" Click="StartStopButton_Click" />
                        <TextBlock x:Name="ConnectionMessageText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="2,13,2,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Desempenho" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Taxa total de todos os workers." Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,5,0,24" />

                    <TextBlock Text="HASHRATE" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="HashrateText" Text="0,00 H/s" FontSize="34" FontWeight="SemiBold" />

                    <UniformGrid Columns="2" Margin="0,25,0,0">
                        <StackPanel>
                            <TextBlock Text="HASHES" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="HashesText" Text="0" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="UPTIME" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="UptimeText" Text="00:00:00" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACEITAS" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="AcceptedText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="REJEITADAS" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="RejectedText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#F4C96B" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ShareNotificationBorder" Background="#173D2E" CornerRadius="14" Padding="16" Margin="0,18,0,0" Visibility="Collapsed" Opacity="0">
                    <StackPanel>
                        <TextBlock x:Name="ShareNotificationTitle" Text="Share aceita" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock x:Name="ShareNotificationText" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#151B24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                    <TextBlock Text="Uma share aceita foi contabilizada pelo pool. O pagamento depende das regras e do saldo mínimo do próprio pool." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="Vanta não solicita seed phrase, chave privada ou senha da carteira." Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" />
    </Grid>
</Window>
